# Local development only. Copy to .env and replace values outside local use.
TRADEFLOW_ENVIRONMENT=development
TRADEFLOW_DATABASE_URL=postgresql+asyncpg://tradeflow:tradeflow@localhost:5433/tradeflow
TRADEFLOW_AUTH_ISSUER=https://identity.test
TRADEFLOW_AUTH_AUDIENCE=tradeflow-api
TRADEFLOW_AUTH_TEST_SECRET=replace-with-at-least-32-local-characters
TRADEFLOW_TELEMETRY_ENABLED=false

TRADEFLOW_WORKER_ENVIRONMENT=development
TRADEFLOW_WORKER_REDIS_URL=redis://localhost:6380/0
TRADEFLOW_WORKER_TELEMETRY_ENABLED=false

TRADEFLOW_API_URL=http://localhost:8000
TRADEFLOW_WEB_TEST_ACCESS_TOKEN=
EXPO_PUBLIC_TRADEFLOW_API_URL=http://localhost:8000
EXPO_PUBLIC_TRADEFLOW_TEST_ACCESS_TOKEN=
