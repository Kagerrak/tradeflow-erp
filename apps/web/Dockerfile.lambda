# Lambda container image for the Next.js server tier.
#
# The application is unchanged from the container the demo already runs: the
# Lambda Web Adapter (an AWS-maintained extension) runs the same standalone
# `next start` server and translates Lambda invocations into HTTP requests.
# Running the framework's own server means every feature the app uses — server
# rendering, route handlers, `proxy.ts` middleware, cookies, authentication and
# `next/image` optimisation — behaves exactly as it does locally.
#
# The image is deliberately pinned to the application's Next.js version: no
# downgrade and no framework-specific rebuild step is involved.
FROM node:22.18.0-bookworm-slim AS build
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH"
RUN corepack enable && corepack prepare pnpm@9.7.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages packages
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
RUN pnpm --filter @tradeflow/web build


FROM node:22.18.0-bookworm-slim AS runtime
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1 /lambda-adapter /opt/extensions/lambda-adapter
ENV NODE_ENV=production \
    HOSTNAME=127.0.0.1 \
    PORT=3000 \
    AWS_LWA_PORT=3000 \
    AWS_LWA_READINESS_CHECK_PATH=/api/health \
    AWS_LWA_READINESS_CHECK_TIMEOUT=60 \
    AWS_LWA_INVOKE_MODE=buffered \
    AWS_LWA_ASYNC_INIT=false
WORKDIR /app
RUN groupadd --system --gid 10001 tradeflow && useradd --system --uid 10001 --gid tradeflow tradeflow
COPY --from=build --chown=tradeflow:tradeflow /app/apps/web/.next/standalone ./
COPY --from=build --chown=tradeflow:tradeflow /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=tradeflow:tradeflow /app/apps/web/public ./apps/web/public
# Lambda's filesystem is read-only except /tmp. Next.js caches optimised images
# under .next/cache, so point that path at the writable tmpfs.
RUN mkdir -p /tmp/next-cache && ln -s /tmp/next-cache apps/web/.next/cache
USER tradeflow
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
