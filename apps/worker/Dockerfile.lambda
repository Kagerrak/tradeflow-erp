# Lambda container image for background jobs (SQS consumer) and the demo reset.
#
# The same image runs:
#   * tradeflow_worker.lambda_handler.handler   - SQS-triggered outbox jobs
#   * tradeflow_worker.demo_reset_job.run_demo_reset - demo data rebuild
# and ships `scripts/` so the demo seeder is reused rather than duplicated.
FROM ghcr.io/astral-sh/uv:0.8.13-python3.13-bookworm-slim AS build

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /var/task

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/worker/pyproject.toml apps/worker/pyproject.toml
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY scripts scripts

RUN uv sync --frozen --package tradeflow-worker --no-dev


FROM ghcr.io/astral-sh/uv:0.8.13-python3.13-bookworm-slim

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/var/task \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /var/task

COPY --from=build /opt/venv /opt/venv
COPY --from=build /var/task /var/task

CMD ["tradeflow_worker.lambda_handler.handler"]
