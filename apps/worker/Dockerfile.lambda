# Lambda container image for background jobs (SQS consumer) and the demo reset.
#
# Built on the AWS Lambda Python base image so the Runtime Interface Client is
# present. The same image runs:
#   * tradeflow_worker.lambda_handler.handler         - SQS-triggered outbox jobs
#   * tradeflow_worker.demo_reset_job.run_demo_reset  - demo data rebuild
# It ships scripts/ so the demo seeder is reused rather than duplicated.
FROM public.ecr.aws/lambda/python:3.13 AS build

COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /usr/local/bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /var/task

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/worker/pyproject.toml apps/worker/pyproject.toml
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY scripts scripts

RUN uv sync --frozen --package tradeflow-worker --no-dev


FROM public.ecr.aws/lambda/python:3.13

# Packages are installed directly into the runtime's own site-packages rather
# than referenced through PYTHONPATH: the Lambda runtime owns PYTHONPATH and a
# module that is only reachable through a custom value fails to import.
# /var/task is added with a .pth file for the same reason.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /var/task

COPY --from=build /opt/venv/lib/python3.13/site-packages/ /var/lang/lib/python3.13/site-packages/
RUN printf '/var/task\n' > /var/lang/lib/python3.13/site-packages/tradeflow-workspace.pth
COPY --from=build /var/task /var/task
# The Lambda runtime runs as a non-root user, so every source file must be
# world-readable regardless of the umask it was authored with.
RUN chmod -R a+rX /var/task

CMD ["tradeflow_worker.lambda_handler.handler"]
