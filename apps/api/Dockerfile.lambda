# Lambda container image for the TradeFlow business API and the migration job.
#
# The repository layout is preserved inside the image (/var/task/apps/api/...)
# so `alembic.ini`, `migrations/` and `scripts/` resolve exactly as they do in
# development. Packaging is done with uv, which keeps the image reproducible
# from uv.lock.
FROM ghcr.io/astral-sh/uv:0.8.13-python3.13-bookworm-slim AS build

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /var/task

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/worker/pyproject.toml apps/worker/pyproject.toml
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY scripts scripts

RUN uv sync --frozen --package tradeflow-api --no-dev


FROM ghcr.io/astral-sh/uv:0.8.13-python3.13-bookworm-slim

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/var/task \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRADEFLOW_ALEMBIC_INI=/var/task/apps/api/alembic.ini

WORKDIR /var/task

COPY --from=build /opt/venv /opt/venv
COPY --from=build /var/task /var/task

# Default entry point is the API. The migration job overrides the handler with
# tradeflow_api.migration_handler.handler so both share one immutable image.
CMD ["tradeflow_api.lambda_handler.handler"]
