{
  "expo": {
    "name": "TradeFlow",
    "slug": "tradeflow-erp",
    "scheme": "tradeflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f9fc"
    },
    "ios": {
      "bundleIdentifier": "com.tradeflow.erp",
      "supportsTablet": true
    },
    "android": {
      "package": "com.tradeflow.erp",
      "predictiveBackGestureEnabled": true
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
