{
  "name": "@tradeflow/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform all --output-dir dist",
    "dev": "expo start",
    "doctor": "expo-doctor",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand components/platform-home.integration.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "0.4.1",
    "@expo-google-fonts/newsreader": "0.4.1",
    "@expo/metro-runtime": "~57.0.9",
    "@tradeflow/api-client": "workspace:*",
    "@tradeflow/customer-directory": "workspace:*",
    "@tradeflow/delivery-dispatch": "workspace:*",
    "@tradeflow/design-tokens": "workspace:*",
    "@tradeflow/inventory-directory": "workspace:*",
    "@tradeflow/payment-clearance": "workspace:*",
    "@tradeflow/platform-session": "workspace:*",
    "@tradeflow/sales-order-draft": "workspace:*",
    "@tradeflow/telemetry": "workspace:*",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "cross-fetch": "4.1.0",
    "eslint": "^9.32.0",
    "eslint-config-expo": "57.0.1",
    "expo-doctor": "^1.17.11",
    "jest": "29.7.0",
    "jest-expo": "~57.0.4",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.cjs"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "testTimeout": 15000
  }
}
